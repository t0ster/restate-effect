{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "overrides": [
    {
      "files": ["src/semaphore/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [{
            "group": ["../*", "@t0ster/restate-effect/*", "!@t0ster/restate-effect/semaphore"],
            "message": "src/semaphore uses only the package's public entry: import { Restate } from \"@t0ster/restate-effect\"."
          }]
        }]
      }
    }
  ]
}
